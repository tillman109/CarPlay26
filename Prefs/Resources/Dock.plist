			<false/>
			<key>cellClass</key>
			<string>CP26InfoSwitchCell</string>
			<key>CP26Help</key>
			<string>Changes the dock’s launcher icon to an outlined square on the app grid and a nine-square grid on the Dashboard or inside an app. The icons crossfade as you move between screens</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Pinned shortcut</string>
