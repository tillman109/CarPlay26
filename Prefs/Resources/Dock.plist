			<string>Appearance</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Glass Dock</string>
			<key>defaults</key>
			<string>com.tillman109.carplay26</string>
			<key>key</key>
			<string>GlassDockAppearance</string>
			<key>default</key>
			<false/>
			<key>cellClass</key>
			<string>CP26InfoSwitchCell</string>
			<key>CP26Help</key>
<string>Uses the compact glass dock across apps, the Dashboard and the app grid on displays with a bottom dock. Places Home and time on the left, apps in the centre and status on the right. Hides the Settings shortcut in the dock. Restart CarPlay Services to apply</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>iOS 26-Style Dock</string>
