			<string>com.tillman109.carplay26</string>
			<key>key</key>
			<string>DockLiquidStyle</string>
			<key>default</key>
			<false/>
			<key>cellClass</key>
			<string>CP26InfoSwitchCell</string>
			<key>CP26Help</key>
			<string>Adds a clearer tint, a highlight and a fine rim to the glass dock. Turn on Glass Dock too, then restart CarPlay Services</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>App launcher</string>
